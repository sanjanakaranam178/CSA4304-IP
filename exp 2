<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luxury Hotel Booking</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#f5f5f5;
}

header{
background:linear-gradient(90deg,#0f2027,#203a43,#2c5364);
color:white;
padding:20px;
text-align:center;
font-size:35px;
font-weight:bold;
}

nav{
display:flex;
justify-content:center;
background:#222;
}

nav a{
color:white;
text-decoration:none;
padding:18px 25px;
font-weight:bold;
}

nav a:hover{
background:#ff9800;
}

.hero{
height:500px;
background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
url("https://images.unsplash.com/photo-1566073771259-6a8506099945");
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
color:white;
text-align:center;
}

.hero h1{
font-size:55px;
}

.hero p{
font-size:22px;
margin:20px;
}

.hero button{
padding:15px 35px;
font-size:18px;
border:none;
background:#ff9800;
color:white;
border-radius:30px;
cursor:pointer;
}

.hero button:hover{
background:red;
}

section{
padding:50px;
}

.title{
text-align:center;
font-size:35px;
margin-bottom:30px;
color:#203a43;
}

.rooms{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.room{
background:white;
padding:20px;
border-radius:15px;
box-shadow:0 5px 10px gray;
text-align:center;
}

.room h2{
color:#ff9800;
margin-bottom:15px;
}

.room p{
margin:10px;
}

.room button{
background:#203a43;
color:white;
padding:10px 20px;
border:none;
cursor:pointer;
}

form{
width:420px;
margin:auto;
background:white;
padding:30px;
border-radius:15px;
box-shadow:0 5px 10px gray;
}

form h2{
text-align:center;
margin-bottom:20px;
}

input,select{
width:100%;
padding:12px;
margin:10px 0;
border:1px solid gray;
border-radius:8px;
}

button{
width:100%;
padding:12px;
background:#ff9800;
color:white;
border:none;
font-size:18px;
cursor:pointer;
}

button:hover{
background:#e65100;
}

footer{
background:#222;
color:white;
padding:30px;
text-align:center;
margin-top:40px;
}

</style>

</head>

<body>

<header>

🏨 Luxury Hotel Booking System

</header>

<nav>

<a href="#">Home</a>

<a href="#">Rooms</a>

<a href="#">Booking</a>

<a href="#">Login</a>

<a href="#">Register</a>

<a href="#">Admin</a>

<a href="#">Contact</a>

</nav>

<div class="hero">

<h1>Welcome To Luxury Hotel</h1>

<p>Book Your Dream Stay Today</p>

<button>Book Now</button>

</div>

<section>

<h1 class="title">Room Types</h1>

<div class="rooms">

<div class="room">

<h2>Standard Room</h2>

<p>✔ AC Room</p>

<p>✔ Free WiFi</p>

<p>✔ TV</p>

<p><b>$50 / Night</b></p>

<button>Book</button>

</div>

<div class="room">

<h2>Deluxe Room</h2>

<p>✔ King Size Bed</p>

<p>✔ Breakfast</p>

<p>✔ Swimming Pool</p>

<p><b>$90 / Night</b></p>

<button>Book</button>

</div>

<div class="room">

<h2>Suite Room</h2>

<p>✔ Luxury Interior</p>

<p>✔ Ocean View</p>

<p>✔ Mini Bar</p>

<p><b>$150 / Night</b></p>

<button>Book</button>

</div>

<div class="room">

<h2>Family Room</h2>

<p>✔ 4 Beds</p>

<p>✔ Kids Area</p>

<p>✔ Free Dinner</p>

<p><b>$180 / Night</b></p>

<button>Book</button>

</div>

</div>

</section>

<section>

<h1 class="title">User Login</h1>

<form>

<h2>Login</h2>

<input type="text" placeholder="Username">

<input type="password" placeholder="Password">

<button>Login</button>

</form>

</section>

<section>

<h1 class="title">User Registration</h1>

<form>

<h2>Create Account</h2>

<input type="text" placeholder="Full Name">

<input type="email" placeholder="Email">

<input type="text" placeholder="Phone">

<input type="password" placeholder="Password">

<button>Register</button>

</form>

</section>
