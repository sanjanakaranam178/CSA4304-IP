<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Management System</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#f3f6ff;
}

header{
background:linear-gradient(90deg,#0066ff,#00c6ff);
color:white;
padding:20px;
text-align:center;
font-size:32px;
font-weight:bold;
}

nav{
display:flex;
justify-content:center;
background:#111;
}

nav a{
color:white;
padding:18px;
text-decoration:none;
font-weight:bold;
transition:.4s;
}

nav a:hover{
background:#00bfff;
}

.hero{
height:450px;
background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da');
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
color:white;
}

.hero h1{
font-size:50px;
}

.hero p{
font-size:22px;
margin:20px;
}

.hero button{
padding:15px 40px;
font-size:18px;
border:none;
background:orange;
color:white;
border-radius:30px;
cursor:pointer;
}

.hero button:hover{
background:red;
}

.section-title{
text-align:center;
font-size:35px;
margin-top:40px;
color:#003366;
}

.container{
width:90%;
margin:auto;
padding:20px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
margin-top:30px;
}

.card{
background:white;
padding:25px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.2);
transition:.4s;
text-align:center;
}

.card:hover{
transform:translateY(-10px);
}

.card h2{
color:#0066ff;
margin-bottom:15px;
}

.card p{
color:#555;
}

form{
width:420px;
margin:30px auto;
background:white;
padding:30px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.2);
}

form h2{
text-align:center;
margin-bottom:20px;
color:#0066ff;
}

input{
width:100%;
padding:12px;
margin:10px 0;
border:1px solid gray;
border-radius:8px;
}

button{
width:100%;
padding:12px;
background:#0066ff;
color:white;
border:none;
border-radius:8px;
font-size:18px;
cursor:pointer;
}

button:hover{
background:#003399;
}

table{
width:100%;
border-collapse:collapse;
margin-top:30px;
background:white;
}

table th{
background:#0066ff;
color:white;
padding:15px;
}

table td{
padding:15px;
text-align:center;
border:1px solid #ddd;
}

footer{
margin-top:40px;
background:#111;
color:white;
padding:30px;
text-align:center;
}

</style>

</head>

<body>

<header>
📚 Library Management System
</header>

<nav>

<a href="#">Home</a>

<a href="#">Books</a>

<a href="#">Admin</a>

<a href="#">Student</a>

<a href="#">Materials</a>

<a href="#">Contact</a>

</nav>

<section class="hero">

<h1>Welcome To Library</h1>

<p>Search • Borrow • Download Materials • Manage Books</p>

<button>Explore Library</button>

</section>

<h1 class="section-title">Main Features</h1>

<div class="container">

<div class="cards">

<div class="card">
<h2>🔍 Search Books</h2>
<p>Find any book instantly.</p>
</div>

<div class="card">
<h2>📖 Borrow Books</h2>
<p>Issue books quickly.</p>
</div>

<div class="card">
<h2>💰 Fine Status</h2>
<p>Check overdue fines.</p>
</div>

<div class="card">
<h2>📂 Study Materials</h2>
<p>Semester-wise notes.</p>
</div>

<div class="card">
<h2>👨‍💼 Admin Dashboard</h2>
<p>Manage library easily.</p>
</div>

<div class="card">
<h2>👨‍🎓 Student Profile</h2>
<p>View borrowing history.</p>
</div>

</div>

</div>

<form>

<h2>Student Login</h2>

<input type="text" placeholder="Username">

<input type="password" placeholder="Password">

<button>Login</button>

</form>

<form>

<h2>Student Registration</h2>

<input type="text" placeholder="Full Name">

<input type="email" placeholder="Email">

<input type="text" placeholder="Phone">

<input type="password" placeholder="Password">

<button>Register</button>

</form>
