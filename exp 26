<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FitLife Gym Management</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#0f172a;
color:white;
overflow-x:hidden;
}

/* HEADER */

header{
background:linear-gradient(90deg,#ff512f,#dd2476);
padding:20px 8%;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:1000;
}

.logo{
font-size:32px;
font-weight:700;
}

nav a{
color:white;
text-decoration:none;
margin-left:25px;
font-weight:600;
}

/* HERO */

.hero{
height:100vh;
background:
linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438');
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
}

.hero h1{
font-size:80px;
}

.hero p{
font-size:25px;
margin:20px 0;
}

.btn{
background:#ff512f;
padding:15px 35px;
border:none;
border-radius:30px;
color:white;
font-size:18px;
cursor:pointer;
}

/* STATS */

.stats{
padding:80px 8%;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
background:#111827;
}

.stat{
background:#1f2937;
padding:30px;
border-radius:20px;
text-align:center;
}

.stat h2{
font-size:45px;
color:#ff512f;
}

/* SERVICES */

.services{
padding:80px 8%;
}

.services h2{
text-align:center;
font-size:45px;
margin-bottom:50px;
}

.service-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:#1f2937;
padding:35px;
border-radius:20px;
text-align:center;
transition:.4s;
}

.card:hover{
transform:translateY(-10px);
}

.card i{
font-size:60px;
color:#ff512f;
margin-bottom:15px;
}

/* TRAINERS */

.trainers{
padding:80px 8%;
background:#111827;
}

.trainers h2{
text-align:center;
font-size:45px;
margin-bottom:50px;
}

.trainer-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.trainer{
background:#1f2937;
padding:25px;
border-radius:20px;
text-align:center;
}

.trainer img{
width:130px;
height:130px;
border-radius:50%;
object-fit:cover;
margin-bottom:15px;
}

/* MEMBERSHIP */

.membership{
padding:80px 8%;
}

.price-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.price-card{
background:#1f2937;
padding:35px;
border-radius:20px;
text-align:center;
}

.price{
font-size:50px;
color:#ff512f;
margin:20px 0;
}

/* BMI */

.bmi{
padding:80px 8%;
background:#111827;
}

.bmi-box{
max-width:700px;
margin:auto;
background:#1f2937;
padding:40px;
border-radius:20px;
}

input{
width:100%;
padding:15px;
margin:10px 0;
border:none;
border-radius:10px;
}

/* DASHBOARD */

.dashboard{
padding:80px 8%;
}

.dashboard-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.box{
background:#1f2937;
padding:30px;
border-radius:20px;
text-align:center;
}

/* FOOTER */

footer{
background:black;
padding:40px;
text-align:center;
}

</style>
</head>

<body>

<header>

<div class="logo">🏋️ FitLife</div>

<nav>
<a href="#">Home</a>
<a href="#">Membership</a>
<a href="#">Trainers</a>
<a href="#">Workout</a>
<a href="#">Login</a>
</nav>

</header>

<section class="hero">

<div>
<h1>Transform Your Body</h1>
<p>Train Hard • Stay Fit • Live Strong</p>
<button class="btn">Join Now</button>
</div>

</section>

<section class="stats">

<div class="stat">
<h2>5000+</h2>
<p>Members</p>
</div>

<div class="stat">
<h2>50+</h2>
<p>Professional Trainers</p>
</div>

<div class="stat">
<h2>100+</h2>
<p>Workout Programs</p>
</div>

<div class="stat">
<h2>24/7</h2>
<p>Gym Access</p>
</div>

</section>

<section class="services">

<h2>💪 Our Services</h2>

<div class="service-grid">

<div class="card">
<i class="fas fa-dumbbell"></i>
<h3>Weight Training</h3>
</div>

<div class="card">
<i class="fas fa-heartbeat"></i>
<h3>Cardio Fitness</h3>
</div>

<div class="card">
<i class="fas fa-apple-alt"></i>
<h3>Diet Plans</h3>
</div>

<div class="card">
<i class="fas fa-running"></i>
<h3>Personal Training</h3>
</div>

</div>

</section>

<section class="trainers">

<h2>🏆 Expert Trainers</h2>

<div class="trainer-grid">

<div class="trainer">
<img src="https://randomuser.me/api/portraits/men/45.jpg">
<h3>John Fitness</h3>
<p>Strength Coach</p>
</div>

<div class="trainer">
<img src="https://randomuser.me/api/portraits/women/44.jpg">
<h3>Sarah Fit</h3>
<p>Yoga Trainer</p>
</div>

<div class="trainer">
<img src="https://randomuser.me/api/portraits/men/75.jpg">
<h3>Mike Power</h3>
<p>Bodybuilding Expert</p>
</div>

</div>

</section>

<section class="membership">

<h2 style="text-align:center;margin-bottom:40px;">
💳 Membership Plans
</h2>

<div class="price-grid">

<div class="price-card">
<h3>Basic</h3>
<div class="price">₹999</div>
<p>Monthly Access</p>
</div>

<div class="price-card">
<h3>Premium</h3>
<div class="price">₹2499</div>
<p>Trainer + Diet Plan</p>
</div>

<div class="price-card">
<h3>Elite</h3>
<div class="price">₹4999</div>
<p>Complete Fitness Package</p>
</div>

</div>

</section>

<section class="bmi">

<div class="bmi-box">

<h2>🎯 BMI Calculator</h2>

<input type="number" placeholder="Enter Height (cm)">
<input type="number" placeholder="Enter Weight (kg)">

<button class="btn">Calculate BMI</button>

</div>

</section>

<section class="dashboard">

<h2 style="text-align:center;margin-bottom:40px;">
📊 Member Dashboard
</h2>

<div class="dashboard-grid">

<div class="box">
<h3>Workout Schedule</h3>
</div>

<div class="box">
<h3>Diet Plans</h3>
</div>

<div class="box">
<h3>Progress Tracker</h3>
</div>

<div class="box">
<h3>Membership Status</h3>
</div>

</div>

</section>

<footer>

<h2>🏋️ FitLife Gym Management</h2>

<p>Strong Body • Strong Mind</p>

<br>

<p>© 2026 FitLife. All Rights Reserved.</p>

</footer>

</body>
</html>
