<!DOCTYPE html>
<html>
<head>
<title>Tech Event 2026</title>
<style>

body{
margin:0;
font-family:Poppins,sans-serif;
background:#f5f7ff;
}

header{
background:linear-gradient(90deg,#7b2ff7,#f107a3);
padding:20px;
color:white;
text-align:center;
}

.hero{
height:80vh;
background:url('https://images.unsplash.com/photo-1511578314322-379afb476865') center/cover;
display:flex;
justify-content:center;
align-items:center;
color:white;
text-align:center;
}

.hero h1{
font-size:70px;
}

.section{
padding:60px;
}

.speakers{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:white;
padding:25px;
border-radius:20px;
text-align:center;
box-shadow:0 0 15px rgba(0,0,0,.1);
}

.btn{
background:#7b2ff7;
color:white;
padding:12px 25px;
border:none;
border-radius:25px;
}

footer{
background:#111827;
color:white;
padding:30px;
text-align:center;
}

</style>
</head>

<body>

<header>
<h1>🎤 Tech Innovation Summit 2026</h1>
</header>

<section class="hero">
<div>
<h1>Future Starts Here</h1>
<p>Meet Industry Experts & Innovators</p>
<button class="btn">Register Now</button>
</div>
</section>

<section class="section">
<h2>🌟 Featured Speakers</h2>

<div class="speakers">

<div class="card">
<h3>Dr. John Smith</h3>
<p>AI Researcher</p>
</div>

<div class="card">
<h3>Sarah Wilson</h3>
<p>Cloud Architect</p>
</div>

<div class="card">
<h3>Michael Lee</h3>
<p>Cybersecurity Expert</p>
</div>

</div>
</section>

<section class="section">
<h2>📅 Event Schedule</h2>
<p>09:00 AM - Opening Ceremony</p>
<p>10:00 AM - AI & Future Technology</p>
<p>01:00 PM - Cloud Computing Session</p>
<p>03:00 PM - Cyber Security Workshop</p>
</section>

<footer>
© 2026 Event Management System
</footer>

</body>
</html>
