<!DOCTYPE html>
<html>
<head>
<title>StayEase Hotel Booking</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>

body{
margin:0;
font-family:Poppins,sans-serif;
background:#f8f9ff;
}

header{
background:linear-gradient(90deg,#6a11cb,#2575fc);
padding:20px;
display:flex;
justify-content:space-between;
color:white;
}

.hero{
height:90vh;
background:url('https://images.unsplash.com/photo-1566073771259-6a8506099945') center/cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-size:75px;
}

.search-box{
background:white;
padding:30px;
margin:-50px auto 50px;
width:85%;
border-radius:20px;
box-shadow:0 10px 20px rgba(0,0,0,.1);
}

.rooms{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:25px;
padding:60px;
}

.room{
background:white;
border-radius:20px;
overflow:hidden;
box-shadow:0 0 15px rgba(0,0,0,.1);
}

.room img{
width:100%;
height:220px;
object-fit:cover;
}

.room-content{
padding:20px;
}

.btn{
background:#2575fc;
color:white;
padding:12px 25px;
border:none;
border-radius:25px;
}

footer{
background:#111827;
color:white;
text-align:center;
padding:30px;
}

</style>
</head>
<body>

<header>
<h2>🏨 StayEase</h2>
<div>Hotels | Rooms | Login</div>
</header>

<section class="hero">
<div>
<h1>Luxury Hotel Booking</h1>
<p>Book Your Dream Stay Anywhere</p>
</div>
</section>

<div class="search-box">
<h2>🔍 Search Hotels</h2>
<p>Location • Check-In • Check-Out • Guests</p>
</div>

<section class="rooms">

<div class="room">
<img src="https://images.unsplash.com/photo-1578683010236-d716f9a3f461">
<div class="room-content">
<h3>Deluxe Suite</h3>
<p>₹5,999/Night</p>
<button class="btn">Book Now</button>
</div>
</div>

<div class="room">
<img src="https://images.unsplash.com/photo-1590490360182-c33d57733427">
<div class="room-content">
<h3>Premium Room</h3>
<p>₹8,999/Night</p>
<button class="btn">Book Now</button>
</div>
</div>

</section>

<footer>
© 2026 StayEase Hotel Reservation System
</footer>

</body>
</html>
